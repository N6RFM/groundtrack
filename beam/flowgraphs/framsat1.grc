- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block for GNU Radio: consumes deframed\
      \ AX.25/FS1.0 PDUs\n(from gr-satellites' AX.25 Deframer, or your own custom\
      \ deframer) on its\n'pdu' message input, and prints decoded FramSat-1 telemetry.\n\
      \nParsing logic ported verbatim from framsat1_iq_decoder.py, which was\nverified\
      \ byte-for-byte against the real repo's framsat1_decoder.py and\nagainst a ground-truth\
      \ framsat1.kss capture.\n\nOptional log_file constructor parameter (shows up\
      \ as a block property in\nGRC's properties dialog automatically): if set to\
      \ a path, every frame's\nexact console output is also appended to that file,\
      \ flushed immediately.\nLeave it blank ('') for console-only output (the original\
      \ behavior).\n\"\"\"\n\nimport struct\nfrom datetime import datetime, timezone\n\
      \nimport pmt\nfrom gnuradio import gr\n\nSIGNATURE = b\"FS1.0\"\nEXPECTED_CALLSIGN\
      \ = \"LA1ORB\"\nHEALTH_FMT = \">5sBBBHBHHI\"\nHEALTH_SIZE = struct.calcsize(HEALTH_FMT)\n\
      SENSOR_SAMPLE_FMT = \">BHHHHBBBBBHI\"\nSENSOR_SAMPLE_SIZE = struct.calcsize(SENSOR_SAMPLE_FMT)\n\
      \n\ndef parse_fs1_telemetry(payload):\n    if len(payload) < HEALTH_SIZE:\n\
      \        return None\n    sign, bcn_id, bcn_type, rssi, cmd_count, eps_flags,\
      \ reboots, v_mv, uptime = \\\n        struct.unpack(HEALTH_FMT, payload[:HEALTH_SIZE])\n\
      \    result = {\n        \"signature\": sign.decode(\"ascii\", errors=\"replace\"\
      ),\n        \"beacon_id\": bcn_id,\n        \"operating_mode\": \"LEOP (Launch\
      \ / Deployment Mode)\" if bcn_type == 2 else \"DEFAULT (Nominal Orbit)\",\n\
      \        \"satellite_uplink_rssi\": f\"-{rssi} dBm\" if rssi > 0 else \"N/A\
      \ (No uplink signal received)\",\n        \"telecommands_accepted\": cmd_count,\n\
      \        \"eps_flags\": f\"0x{eps_flags:02X}\",\n        \"reboot_count\": reboots,\n\
      \        \"battery_voltage_v\": v_mv / 1000.0,\n        \"battery_voltage_mv\"\
      : v_mv,\n        \"uptime_sec\": uptime,\n        \"uptime_hours\": uptime /\
      \ 3600.0,\n    }\n    raw_sensors = payload[HEALTH_SIZE:-4] if len(payload)\
      \ >= HEALTH_SIZE + 4 else payload[HEALTH_SIZE:]\n    trailer = payload[-4:]\
      \ if len(payload) >= HEALTH_SIZE + 4 else b\"\"\n    result[\"trailer_hex\"\
      ] = trailer.hex().upper()\n    if bcn_type == 2 and all(b == 0 for b in raw_sensors):\n\
      \        result[\"sensor_status\"] = f\"Sensors unpowered during deployment\
      \ ({len(raw_sensors)} bytes zero-padded).\"\n        result[\"sensors\"] = []\n\
      \        return result\n    sensors = []\n    n_samples = len(raw_sensors) //\
      \ SENSOR_SAMPLE_SIZE\n    for i in range(min(n_samples, 9)):\n        chunk\
      \ = raw_sensors[i * SENSOR_SAMPLE_SIZE:(i + 1) * SENSOR_SAMPLE_SIZE]\n     \
      \   if len(chunk) == SENSOR_SAMPLE_SIZE:\n            s_id, g_a, g_b, g_c, g_d,\
      \ e_x, e_y, i1, i2, i3, s_size, s_time = \\\n                struct.unpack(SENSOR_SAMPLE_FMT,\
      \ chunk)\n            sensors.append({\"sample\": i + 1, \"time_s\": s_time,\
      \ \"gss\": (g_a, g_b, g_c, g_d),\n                             \"ess_xy\": (e_x,\
      \ e_y), \"ess_illum\": (i1, i2, i3)})\n    result[\"sensors\"] = sensors\n \
      \   result[\"sensor_status\"] = None\n    return result\n\n\ndef format_decoded_frame(payload):\n\
      \    \"\"\"Builds the full display text for one frame as a single string\n \
      \   (used for both console printing and file logging, guaranteeing they\n  \
      \  are always byte-for-byte identical to each other).\"\"\"\n    lines = []\n\
      \n    def emit(s=\"\"):\n        lines.append(s)\n\n    ts_str = datetime.now(timezone.utc).strftime(\"\
      %Y-%m-%d %H:%M:%S\") + \" UTC\"\n    emit(\"\\n\" + \"=\" * 65)\n    emit(f\"\
      \\U0001F6F0\\uFE0F  FramSat-1 Frame Received at {ts_str}\")\n    emit(f\"  \
      \ Total Frame Length: {len(payload)} bytes\")\n\n    idx = payload.find(SIGNATURE)\n\
      \    if idx == -1:\n        emit(f\"   Payload Raw Hex:    {payload.hex().upper()}\"\
      )\n        emit(\"=\" * 65 + \"\\n\")\n        return \"\\n\".join(lines) +\
      \ \"\\n\"\n\n    emit(f\"   Telemetry Found:    Offset index {idx}\")\n    if\
      \ idx >= 16:\n        dest_call = \"\".join(chr(b >> 1) for b in payload[0:6]).strip()\n\
      \        src_call = \"\".join(chr(b >> 1) for b in payload[7:13]).strip()\n\
      \        emit(f\"   Encapsulation:      AX.25 UI-Frame ({src_call} -> {dest_call})\"\
      )\n        emit(f\"   Source:             {src_call} (Expected: {EXPECTED_CALLSIGN})\"\
      )\n    elif idx > 0:\n        emit(f\"   Transport Header:   {payload[:idx].hex().upper()}\
      \ ({idx} bytes)\")\n    else:\n        emit(\"   Encapsulation:      Direct\
      \ HDLC (Payload starts at offset 0)\")\n\n    tlm = parse_fs1_telemetry(payload[idx:])\n\
      \    if tlm is None:\n        emit(f\"   Payload Raw Hex: {payload[idx:].hex().upper()}\"\
      )\n        emit(\"=\" * 65 + \"\\n\")\n        return \"\\n\".join(lines) +\
      \ \"\\n\"\n\n    emit(\"\\n   \\u2500\\u2500\\u2500 [ FramSat-1 Housekeeping\
      \ Telemetry ] \\u2500\\u2500\\u2500\")\n    emit(f\"   Signature:          \
      \   {tlm['signature']}\")\n    emit(f\"   Beacon ID:             #{tlm['beacon_id']}\"\
      )\n    emit(f\"   Operating Mode:        {tlm['operating_mode']}\")\n    emit(f\"\
      \   Satellite Uplink RSSI: {tlm['satellite_uplink_rssi']}\")\n    emit(f\" \
      \  Telecommands Accepted: {tlm['telecommands_accepted']}\")\n    emit(f\"  \
      \ EPS Flags:             {tlm['eps_flags']}\")\n    emit(f\"   OBC / EPS Reboot\
      \ Count:{tlm['reboot_count']}\")\n    emit(f\"   Battery Voltage:       {tlm['battery_voltage_v']:.3f}\
      \ V ({tlm['battery_voltage_mv']} mV)\")\n    emit(f\"   Satellite Uptime:  \
      \    {tlm['uptime_sec']} s ({tlm['uptime_hours']:.2f} hours)\")\n\n    if tlm[\"\
      sensor_status\"]:\n        emit(f\"\\n   \\u2500\\u2500\\u2500 [ Attitude Sensors\
      \ (LEOP Mode) ] \\u2500\\u2500\\u2500\")\n        emit(f\"   Status:       \
      \        {tlm['sensor_status']}\")\n    elif tlm[\"sensors\"]:\n        emit(f\"\
      \\n   \\u2500\\u2500\\u2500 [ Attitude Sensors: {len(tlm['sensors'])}x Samples\
      \ ] \\u2500\\u2500\\u2500\")\n        emit(\"   # | Time (s)    | Sun Sensor\
      \ GSS (a, b, c, d)            | Earth Sensor ESS (x, y, illum)\")\n        emit(\"\
      \  \u2500\u2500\u2500+\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
      \u2500\u2500\u2500\u2500+\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
      \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
      \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
      \u2500\u2500\u2500\u2500\u2500+\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
      \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\
      \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\")\n        for\
      \ s in tlm[\"sensors\"]:\n            g_a, g_b, g_c, g_d = s[\"gss\"]\n    \
      \        e_x, e_y = s[\"ess_xy\"]\n            i1, i2, i3 = s[\"ess_illum\"\
      ]\n            gss_str = f\"{g_a:5d}, {g_b:5d}, {g_c:5d}, {g_d:5d}\"\n     \
      \       ess_str = f\"X={e_x:3d}, Y={e_y:3d}, Illum=[{i1},{i2},{i3}]\"\n    \
      \        emit(f\"   {s['sample']:1d} | {s['time_s']:<11d} | {gss_str:<38s} |\
      \ {ess_str}\")\n\n    emit(\"=\" * 65 + \"\\n\")\n    return \"\\n\".join(lines)\
      \ + \"\\n\"\n\n\nclass blk(gr.basic_block):\n    \"\"\"FS1.0 Telemetry Sink\
      \ -- message-only block, no stream I/O.\n\n    log_file: optional path (GRC\
      \ block parameter). If non-empty, every\n    frame's output is also appended\
      \ there, flushed immediately -- useful\n    for keeping a guaranteed-plain-text\
      \ record independent of whatever is\n    capturing/rendering the console (screenshots,\
      \ GUI consoles, etc. can\n    all mis-render monospace text; a file opened later\
      \ in any genuinely\n    monospace viewer settles that).\n    \"\"\"\n\n    def\
      \ __init__(self, log_file=\"\"):\n        gr.basic_block.__init__(self, name=\"\
      FS1.0 Telemetry Sink\", in_sig=[], out_sig=[])\n        self.message_port_register_in(pmt.intern(\"\
      pdu\"))\n        self.set_msg_handler(pmt.intern(\"pdu\"), self.handle_msg)\n\
      \        self._log_fh = open(log_file, \"a\", encoding=\"utf-8\") if log_file\
      \ else None\n\n    def handle_msg(self, msg):\n        try:\n            payload\
      \ = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        except Exception:\n\
      \            return\n        text = format_decoded_frame(payload)\n        print(text,\
      \ end=\"\")\n        if self._log_fh is not None:\n            self._log_fh.write(text)\n\
      \            self._log_fh.flush()\n\n    def stop(self):\n        if self._log_fh\
      \ is not None:\n            self._log_fh.close()\n            self._log_fh =\
      \ None\n        return True\n"
    affinity: ''
    alias: ''
    comment: 'Fully self-contained: this block''s code is embedded directly in this
      .grc file (not pasted in separately), so opening this file in GRC always gives
      the current, verified FS1.0 parsing/printing logic -- no separate copy-paste
      step to go stale.'
    log_file: '"/home/bob/framsat1_log5.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''FS1.0 Telemetry Sink'', ''blk'', [(''log_file'', "''''")], [(''pdu'',
      ''message'', 1)], [], "FS1.0 Telemetry Sink -- message-only block, no stream
      I/O.\n\n    log_file: optional path (GRC block parameter). If non-empty, every\n    frame''s
      output is also appended there, flushed immediately -- useful\n    for keeping
      a guaranteed-plain-text record independent of whatever is\n    capturing/rendering
      the console (screenshots, GUI consoles, etc. can\n    all mis-render monospace
      text; a file opened later in any genuinely\n    monospace viewer settles that).\n    ",
      [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1480.0, 120]
    rotation: 90
    state: true
